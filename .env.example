# Telegram Bot Configuration
# Token from @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_BOT_USERNAME="your_language_bot"

# Supabase Configuration
# Project URL and anon public key from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Keep secret! Only used on backend route handlers)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase JWT Secret (From Supabase Dashboard -> Project Settings -> API -> JWT Settings)
# Used to mint custom JWTs matching auth.uid() for Row Level Security
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# OpenRouter AI (For Context Generation, Card Checking & Magic Deck Builder)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Recommended model: google/gemini-2.5-flash or meta-llama/llama-3-8b-instruct
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Speech-to-Text (STT) - Whisper API
# Recommended fast & cheap: Groq Whisper (https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."

# Alternative STT: OpenAI Whisper (if Groq is not used)
OPENAI_API_KEY="sk-..."
