# Telegram Bot Configuration
# Token from @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_BOT_USERNAME="your_language_bot"

# Supabase Configuration
# Project URL and anon public key from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Keep secret! Only used on backend route handlers)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase JWT Secret (From Supabase Dashboard -> Project Settings -> API -> JWT Settings)
# Used to mint custom JWTs matching auth.uid() for Row Level Security
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Google Gemini API (For Answer Checking, Dynamic Context, Magic Deck Builder & Audio STT)
# Get free API key at Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
# Recommended model: gemini-2.5-flash-lite or gemini-2.0-flash-lite
GEMINI_MODEL="gemini-2.5-flash-lite"
